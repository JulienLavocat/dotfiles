[user]
	name = Julien Lavocat
	email = julien.lavocat@gmail.com
	signingkey = A8501999FBD213C37AF5ED641E29B9D246D8F82C
[init]
	defaultBranch = main
[pull]
	rebase = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[commit]
	gpgsign = true
[tag]
	gpgSign = true
[fetch]
	prune = true
